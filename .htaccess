# AD Fitness Market — hébergement OVH (Apache). Fichier généré par source/build_pages.py.
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Fichiers et dossiers cachés (.vercel, .gitignore…) et vercel.json : jamais servis
RewriteRule (^|/)\. - [R=404,L]
RewriteRule ^vercel\.json$ - [R=404,L]

# HTTPS et adresse sans www (seulement sur le vrai domaine : l'adresse technique OVH sert aux tests)
RewriteCond %{HTTP_HOST} ^(www\.)?adfitnessmarket\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://adfitnessmarket.com%{REQUEST_URI} [R=301,L,NE]

# Anciennes adresses du site WordPress (redirections permanentes)
RewriteRule ^service\-apres\-vente/?$ https://adfitnessmarket.com/sav-depannage [R=301,L,NE]
RewriteRule ^installation\-pro/?$ https://adfitnessmarket.com/installation [R=301,L,NE]
RewriteRule ^montage\-et\-demontage/?$ https://adfitnessmarket.com/montage-demontage [R=301,L,NE]
RewriteRule ^hotel/?$ https://adfitnessmarket.com/hotels [R=301,L,NE]
RewriteRule ^entreprise/?$ https://adfitnessmarket.com/entreprises [R=301,L,NE]
RewriteRule ^services\-entreprises/?$ https://adfitnessmarket.com/entreprises [R=301,L,NE]
RewriteRule ^college\-et\-universite/?$ https://adfitnessmarket.com/etablissements-scolaires [R=301,L,NE]
RewriteRule ^appareil\-medical/?$ https://adfitnessmarket.com/reeducation-medical [R=301,L,NE]
RewriteRule ^centre\-bien\-etre/?$ https://adfitnessmarket.com/bien-etre [R=301,L,NE]
RewriteRule ^home\-gym/?$ https://adfitnessmarket.com/particuliers [R=301,L,NE]
RewriteRule ^nos\-services\-particulier/?$ https://adfitnessmarket.com/particuliers [R=301,L,NE]
RewriteRule ^couverture\-geographique\-2/?$ https://adfitnessmarket.com/zone-intervention [R=301,L,NE]
RewriteRule ^nos\-services\-professionnel/?$ https://adfitnessmarket.com/secteurs [R=301,L,NE]
RewriteRule ^service/?$ https://adfitnessmarket.com/secteurs [R=301,L,NE]
RewriteRule ^maintenance/?$ https://adfitnessmarket.com/maintenance-preventive [R=301,L,NE]
RewriteRule ^renseignement\-devis/?$ https://adfitnessmarket.com/#contact [R=301,L,NE]
RewriteRule ^contact/?$ https://adfitnessmarket.com/#contact [R=301,L,NE]
RewriteRule ^mon\-compte/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^test/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^conditions\-generales\-de\-utilisation/?$ https://adfitnessmarket.com/cgu [R=301,L,NE]
RewriteRule ^conditions\-generales\-de\-vente/?$ https://adfitnessmarket.com/cgv [R=301,L,NE]
RewriteRule ^wp\-content/uploads/2022/09/CONDITIONS\-GENERALES\-D\-UTILISATION\.pdf/?$ https://adfitnessmarket.com/assets/legal/conditions-generales-utilisation.pdf [R=301,L,NE]
RewriteRule ^wp\-content/uploads/2022/09/CONDITIONS\-GENERALES\-DE\-VENTE\.pdf/?$ https://adfitnessmarket.com/assets/legal/conditions-generales-vente.pdf [R=301,L,NE]
RewriteRule ^sitemap_index\.xml/?$ https://adfitnessmarket.com/sitemap.xml [R=301,L,NE]
RewriteRule ^page\-sitemap\.xml/?$ https://adfitnessmarket.com/sitemap.xml [R=301,L,NE]
RewriteRule ^blocks\-sitemap\.xml/?$ https://adfitnessmarket.com/sitemap.xml [R=301,L,NE]
RewriteRule ^wp\-sitemap\.xml/?$ https://adfitnessmarket.com/sitemap.xml [R=301,L,NE]
RewriteRule ^blocks(/.*)?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^feed/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^checkout/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^panier/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^cart/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^boutique/?$ https://adfitnessmarket.com/ [R=301,L,NE]
RewriteRule ^shop/?$ https://adfitnessmarket.com/ [R=301,L,NE]

# /index.html et /page.html → adresse propre
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^ https://adfitnessmarket.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?]
RewriteRule ^ https://adfitnessmarket.com/%1 [R=301,L,NE]

# Pas de / final
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://adfitnessmarket.com/$1 [R=301,L,NE]

# Adresses propres : /hotels sert hotels.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Fichiers compressés et mis en cache (vitesse de chargement)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 week"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
